{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "KibbrObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::my-kibbr-logs/*"
    },
    {
      "Sid": "KibbrList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::my-kibbr-logs"
    }
  ]
}
