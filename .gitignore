/target
.dev
sample.ndjson

/lab
/lab-rs

# Everything under testdata/ is scratch: corpora, data directories, builds and run output
# that `gen-logs` and the scripts rebuild. The data the tests read is tracked, in
# tests/data/. `kibbr-bench` keeps its loaded directory, its work and its default results
# under testdata/bench/; a result worth keeping as a baseline is saved by name under
# scripts/bench/results/.
/testdata/

# The six inputs tests/data/hostile/gen_large.py writes: several megabytes each, made again
# by one command, and so not tracked. Every other file in that folder is.
/tests/data/hostile/arr100k.ndjson
/tests/data/hostile/bigline.ndjson
/tests/data/hostile/escape_bomb.ndjson
/tests/data/hostile/hugekey.ndjson
/tests/data/hostile/manykeys.ndjson
/tests/data/hostile/nest200k.ndjson

/brag*

# Claude Code's per-machine state: settings, worktrees.
.claude/

# The design handoff: local only, not committed. The web console copies what it uses into web/.
/.design

# macOS folder metadata.
.DS_Store

# The data directory the docs use in their examples (`kibbr serve --data-dir kibbr-data`).
/kibbr-data/

# The website `npm run site` in web/ renders; GitHub Actions builds and publishes it.
/_site
