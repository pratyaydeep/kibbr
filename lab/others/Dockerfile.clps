# y-scope/clp publishes release tarballs rather than an image whose tag can be pinned
# here, so the tarball is what gets pinned. v0.13.0, released 2026-07-22; the `clp-json`
# package is the one holding clp-s, which is the JSON half of CLP and the half that
# compares to TrieDB at all.
#
# The tarball is x86_64 only. On Apple Silicon this image runs under emulation, which is
# fine for a size measurement and is why 07 labels its timings "rough".
FROM --platform=linux/amd64 ubuntu:24.04

ARG CLP_VERSION=v0.13.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/clp.tar.gz \
      "https://github.com/y-scope/clp/releases/download/${CLP_VERSION}/clp-json-x86_64-${CLP_VERSION}.tar.gz" \
 && mkdir -p /opt/clp \
 && tar -xzf /tmp/clp.tar.gz -C /opt/clp --strip-components=1 \
 && rm /tmp/clp.tar.gz
ENV PATH="/opt/clp/bin:/opt/clp/sbin:${PATH}"
WORKDIR /work
